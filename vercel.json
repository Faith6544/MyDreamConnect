{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/shape/:path*", "destination": "https://oldsite.mydreamconnect.org.ng/shape/:path*", "permanent": false },
    { "source": "/shape2/:path*", "destination": "https://oldsite.mydreamconnect.org.ng/shape2/:path*", "permanent": false },
    { "source": "/enrolment/:path*", "destination": "https://oldsite.mydreamconnect.org.ng/enrolment/:path*", "permanent": false }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}