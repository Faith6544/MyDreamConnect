# Copy this file to `.env` (or `.env.local`) and fill in your own values.
#
# These are read by the React app at build time (CRA only exposes variables
# prefixed with REACT_APP_). The Supabase values are safe to ship to the browser
# ONLY because they are the public/anon (publishable) key — never put a
# service_role key here.
#
# The service_role key used by the scripts in ./scripts must be supplied in the
# shell or in `.env.local` under the name SUPABASE_SERVICE_ROLE_KEY (it is not
# prefixed with REACT_APP_, so CRA will not bundle it).

REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_KEY=your-supabase-publishable-anon-key

# Optional: used by scripts/admin-client.js (seed-ai.js, seed-test.js,
# scrape-website.js). Get it from Supabase → Project Settings → API.
# NEVER commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
